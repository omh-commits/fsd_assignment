# Copy this file to .env and change the values if needed.
# Without a .env file the server uses the XAMPP defaults below.

PORT=5000

# ---- Local MySQL (XAMPP: user root, no password) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=leafy_village

# ---- OR a hosted MySQL in one line (Aiven calls this the "Service URI") ----
# DATABASE_URL=mysql://user:password@host:port/database
# DB_CA_CERT=-----BEGIN CERTIFICATE----- ...the CA certificate text from Aiven...

# Any long random text. Used to sign the login cookie.
SESSION_SECRET=change-this-to-a-long-random-string
